<Window x:Class="RSPAudioRecorder.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="White" FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!-- Rounded checkbox with an accent tick -->
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,0,0,12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1.5"
                      BorderBrush="#9AA4B2" Background="White" VerticalAlignment="Center">
                <Path x:Name="Tick" Data="M 3.5,9 L 7.5,12.5 L 14,5" Stroke="White" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"
                      Margin="-1.5,-1.5,0,0"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Rounded text field -->
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" CornerRadius="7" BorderThickness="1" BorderBrush="#CDD5E0" Background="White"
                    Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#AEB8C6"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,6,0,14"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="DialogButton" TargetType="Button">
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinWidth" Value="84"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="#F4F6F9"/>
      <Setter Property="BorderBrush" Value="#D5DCE5"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="7" BorderThickness="1" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Resources>

  <StackPanel Margin="24,20,24,20">
    <TextBlock Text="File name" Style="{StaticResource Heading}"/>
    <Grid>
      <TextBox x:Name="FileNameBox" Style="{StaticResource Field}" TextChanged="FileNameBox_TextChanged"/>
      <TextBlock x:Name="FileNameHint" Text="Automatic (date and time)" Foreground="{StaticResource Faint}"
                 Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
    </Grid>
    <TextBlock x:Name="FolderHint" Style="{StaticResource Hint}"/>

    <CheckBox x:Name="OpenAfterBox" Content="Open audio file after saving"/>
    <CheckBox x:Name="TranscriptBox" Content="Live transcript"/>
    <CheckBox x:Name="MicBox" Content="Record my microphone (applies from the next recording)" Margin="0,0,0,18"/>

    <TextBlock Text="Show / hide shortcut" Style="{StaticResource Heading}"/>
    <TextBox x:Name="HotkeyBox" Style="{StaticResource Field}" Width="240" HorizontalAlignment="Left" IsReadOnly="True"
             IsReadOnlyCaretVisible="False" Cursor="Hand" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
             GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"/>
    <TextBlock x:Name="HotkeyHint" Text="Click the box and press a new key combination." Style="{StaticResource Hint}"/>

    <CheckBox x:Name="StartupBox" Content="Start with Windows (runs in the background)" Margin="0,0,0,22"/>

    <DockPanel LastChildFill="False">
      <Button DockPanel.Dock="Left" Content="Open folder" Style="{StaticResource DialogButton}" Click="Folder_Click"/>
      <Button DockPanel.Dock="Left" Content="Quit" Style="{StaticResource DialogButton}" Margin="8,0,0,0" Click="Quit_Click"
              ToolTip="Close RSP Audio Recorder completely (the shortcut stops working)"/>
      <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource DialogButton}" Margin="8,0,0,0" IsCancel="True"/>
      <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
    </DockPanel>
  </StackPanel>
</Window>
