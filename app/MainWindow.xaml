<Window x:Class="RSPAudioRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RSP Audio Recorder" Width="1060" Height="740" MinWidth="580" MinHeight="262"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{StaticResource Card}" FontFamily="Segoe UI" FontSize="14"
        Foreground="{StaticResource Text}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="58" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <CollectionViewSource x:Key="SessionsView"/>

    <Style x:Key="SessionItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" CornerRadius="10" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="14,10">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="White"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Line}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="SessionTemplate">
      <StackPanel>
        <DockPanel LastChildFill="False">
          <TextBlock DockPanel.Dock="Left" Text="{Binding TimeText}" FontWeight="SemiBold" FontSize="14"/>
          <Border DockPanel.Dock="Left" Margin="8,1,0,0" Padding="7,1" CornerRadius="9" Background="{StaticResource LiveSoft}"
                  VerticalAlignment="Center">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6" Height="6" Fill="{StaticResource Live}" VerticalAlignment="Center"/>
              <TextBlock Text="Live" Margin="4,0,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Live}"/>
            </StackPanel>
          </Border>
          <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" FontSize="12" Foreground="{StaticResource Faint}"
                     VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock Text="{Binding Preview}" Margin="0,4,0,0" FontSize="13" Foreground="{StaticResource Muted}"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" LineHeight="19"/>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="58"/>
      <RowDefinition Height="204"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ============================== Title bar ============================== -->
    <Grid Grid.Row="0">
      <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
        <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource Accent}">
          <Path Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Data="M 8.8,12.7 L 8.8,17.3 M 11.9,10.2 L 11.9,19.8 M 15,8 L 15,22 M 18.1,10.2 L 18.1,19.8 M 21.2,12.7 L 21.2,17.3"/>
        </Border>
        <TextBlock Text="RSP Audio Recorder" FontFamily="Segoe UI Semibold" FontSize="17" Margin="13,0,0,1" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,14,0">
        <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" WindowChrome.IsHitTestVisibleInChrome="True"
                Click="Min_Click" ToolTip="Hide (Ctrl+Shift+Space brings it back)">
          <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 0,0 L 13,0"/>
        </Button>
        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" WindowChrome.IsHitTestVisibleInChrome="True"
                Click="Max_Click" ToolTip="Maximise">
          <Path x:Name="MaxGlyph" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                Data="M 3,0 H 10 A 3,3 0 0 1 13,3 V 10 A 3,3 0 0 1 10,13 H 3 A 3,3 0 0 1 0,10 V 3 A 3,3 0 0 1 3,0 Z"/>
        </Button>
        <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" WindowChrome.IsHitTestVisibleInChrome="True"
                Click="Close_Click" ToolTip="Close (keeps running in the background)">
          <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 0,0 L 13,13 M 13,0 L 0,13"/>
        </Button>
      </StackPanel>
    </Grid>

    <!-- ============================== Recorder ============================== -->
    <Grid Grid.Row="1">
      <!-- Transcript panel toggle (left) -->
      <Button x:Name="TranscriptToggle" Style="{StaticResource IconButton}" HorizontalAlignment="Left" Margin="30,0,0,40"
              VerticalAlignment="Center" Click="TranscriptToggle_Click" ToolTip="Show or hide transcripts">
        <Path Stroke="{StaticResource Glyph}" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              StrokeLineJoin="Round"
              Data="M 4,1 H 16 A 3,3 0 0 1 19,4 V 22 A 3,3 0 0 1 16,25 H 4 A 3,3 0 0 1 1,22 V 4 A 3,3 0 0 1 4,1 Z M 5.5,8 H 14.5 M 5.5,13 H 14.5 M 5.5,18 H 10.5"/>
      </Button>

      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="76"/>
            <ColumnDefinition Width="34"/>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="34"/>
            <ColumnDefinition Width="76"/>
          </Grid.ColumnDefinitions>

          <Button x:Name="PlayButton" Grid.Column="0" Style="{StaticResource RoundButton}" Click="PlayLast_Click"
                  VerticalAlignment="Center" ToolTip="Play the last recording">
            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="3.5"
                  StrokeLineJoin="Round" Data="M 0,0 L 22,13 L 0,26 Z" Margin="5,0,0,0"/>
          </Button>

          <Grid Grid.Column="2" Width="120" Height="120">
            <!-- Glow: breathes with the audio level while recording -->
            <Ellipse x:Name="Glow" Width="176" Height="176" Margin="-28,-20,-28,-36" IsHitTestVisible="False">
              <Ellipse.Fill>
                <RadialGradientBrush>
                  <GradientStop Color="#880A7CFF" Offset="0.55"/>
                  <GradientStop Color="#330A7CFF" Offset="0.75"/>
                  <GradientStop Color="#000A7CFF" Offset="1"/>
                </RadialGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="120" Height="120" Fill="#FCFDFF" Stroke="#160F285A" StrokeThickness="1"/>
            <Button x:Name="MainButton" Style="{StaticResource MainButton}" Click="Main_Click" ToolTip="Record (Space)">
              <Grid>
                <Ellipse x:Name="RecordGlyph" Width="30" Height="30" Fill="White"/>
                <Path x:Name="PauseGlyph" Fill="White" Visibility="Collapsed"
                      Data="M 4.6,0 A 4.6,4.6 0 0 1 9.2,4.6 V 26.4 A 4.6,4.6 0 0 1 0,26.4 V 4.6 A 4.6,4.6 0 0 1 4.6,0 Z M 23.4,0 A 4.6,4.6 0 0 1 28,4.6 V 26.4 A 4.6,4.6 0 0 1 18.8,26.4 V 4.6 A 4.6,4.6 0 0 1 23.4,0 Z"/>
                <Path x:Name="ResumeGlyph" Fill="White" Stroke="White" StrokeThickness="4" StrokeLineJoin="Round"
                      Visibility="Collapsed" Margin="6,0,0,0" Data="M 0,0 L 24,14 L 0,28 Z"/>
              </Grid>
            </Button>
          </Grid>

          <Button x:Name="StopButton" Grid.Column="4" Style="{StaticResource RoundButton}" Click="Stop_Click"
                  VerticalAlignment="Center" IsEnabled="False" ToolTip="Stop and save (S)">
            <Rectangle Width="28" Height="28" RadiusX="5" RadiusY="5"
                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
          <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center" Margin="0,1,8,0" Visibility="Collapsed"/>
          <TextBlock x:Name="StatusText" Text="Ready to record" FontSize="13" Foreground="{StaticResource Muted}"/>
        </StackPanel>
      </StackPanel>

      <!-- Settings (right) -->
      <Button x:Name="GearButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,0,30,40"
              VerticalAlignment="Center" Click="Gear_Click" ToolTip="Settings">
        <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="{StaticResource Glyph}"/>
      </Button>
    </Grid>

    <!-- ============================== Transcripts ============================== -->
    <Border x:Name="Panel" Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="White">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
          <DockPanel>
            <Border DockPanel.Dock="Top" Margin="14,14,14,10" Background="White" CornerRadius="9"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" Height="36">
              <Grid>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource Faint}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock x:Name="SearchHint" Text="Search transcripts" Foreground="{StaticResource Faint}" FontSize="13"
                           VerticalAlignment="Center" Margin="34,0,0,0" IsHitTestVisible="False"/>
                <TextBox x:Name="SearchBox" Margin="30,0,30,0" BorderThickness="0" Background="Transparent" FontSize="13"
                         VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
                <Button x:Name="ClearSearch" HorizontalAlignment="Right" Width="26" Height="26" Margin="0,0,5,0" Padding="0"
                        Style="{StaticResource ToolButton}" Visibility="Collapsed" Click="ClearSearch_Click" ToolTip="Clear search">
                  <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{StaticResource Muted}"/>
                </Button>
              </Grid>
            </Border>

            <TextBlock x:Name="SidebarEmpty" DockPanel.Dock="Top" Margin="22,18,22,0" TextWrapping="Wrap" FontSize="13"
                       Foreground="{StaticResource Muted}" Visibility="Collapsed" LineHeight="20"/>

            <ListBox x:Name="SessionList" ItemsSource="{Binding Source={StaticResource SessionsView}}"
                     ItemTemplate="{StaticResource SessionTemplate}" ItemContainerStyle="{StaticResource SessionItem}"
                     Background="Transparent" BorderThickness="0" Padding="8,0,8,12"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     SelectionChanged="SessionList_SelectionChanged">
              <ListBox.GroupStyle>
                <GroupStyle>
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Faint}"
                                 Margin="14,12,0,6" Typography.Capitals="AllSmallCaps"/>
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </ListBox.GroupStyle>
            </ListBox>
          </DockPanel>
        </Border>

        <!-- Transcript -->
        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid x:Name="Header" Margin="36,18,20,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <Border x:Name="StatusChip" Margin="12,3,0,0" Padding="9,3" CornerRadius="11" VerticalAlignment="Center"
                        Background="{StaticResource LiveSoft}" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ChipDot" Width="7" Height="7" Fill="{StaticResource Live}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ChipText" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Live}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <TextBlock x:Name="SubtitleText" Margin="0,4,0,0" FontSize="13" Foreground="{StaticResource Muted}"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="CopyButton" Style="{StaticResource ToolButton}" Click="Copy_Click" ToolTip="Copy the whole transcript">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"/>
                  <TextBlock x:Name="CopyLabel" Text="Copy" Margin="7,0,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="ExportButton" Style="{StaticResource ToolButton}" Click="Export_Click" ToolTip="Save as a text file">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"/>
                  <TextBlock Text="Export" Margin="7,0,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="PlaySessionButton" Style="{StaticResource ToolButton}" Click="PlaySession_Click" ToolTip="Play this recording">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"/>
                  <TextBlock Text="Play" Margin="7,0,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="FolderButton" Style="{StaticResource ToolButton}" Click="Folder_Click" ToolTip="Show in File Explorer">
                <TextBlock Text="&#xE838;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"/>
              </Button>
            </StackPanel>
          </Grid>
          <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{StaticResource Line}" Margin="36,0,28,0"
                  Visibility="{Binding Visibility, ElementName=Header}"/>

          <RichTextBox x:Name="Doc" Grid.Row="1" IsReadOnly="True" IsDocumentEnabled="True" BorderThickness="0"
                       Background="White" Padding="30,16,32,40" VerticalScrollBarVisibility="Auto" Cursor="IBeam"
                       SelectionBrush="{StaticResource Accent}" ScrollViewer.ScrollChanged="Doc_ScrollChanged">
            <FlowDocument PagePadding="0" FontFamily="Segoe UI" FontSize="15" LineHeight="24"
                          Foreground="{StaticResource TextBody}" TextAlignment="Left"/>
          </RichTextBox>

          <StackPanel x:Name="MainEmpty" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Visibility="Collapsed" MaxWidth="360">
            <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center">
              <TextBlock Text="&#xE720;" FontFamily="{StaticResource Icons}" FontSize="24" Foreground="{StaticResource Accent}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="No transcripts yet" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,6" HorizontalAlignment="Center"/>
            <TextBlock Text="Press the record button. What you say into the microphone and what plays on this PC are transcribed live and kept here."
                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="13" LineHeight="20"/>
          </StackPanel>

          <Button x:Name="JumpLive" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22"
                  Cursor="Hand" Visibility="Collapsed" Click="JumpLive_Click" Focusable="False">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="B" Background="{StaticResource Accent}" CornerRadius="17" Padding="16,8">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.25" Color="#0A7CFF"/>
                  </Border.Effect>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74B;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="Jump to live" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"/>
                  </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="B" Property="Background" Value="#288EFF"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
